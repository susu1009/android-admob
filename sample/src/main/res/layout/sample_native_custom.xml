<?xml version="1.0" encoding="utf-8"?>
<!-- An app-owned native layout: root NativeAdView + the library's admob_* ids. -->
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF3E8FF"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#FF7C3AED"
            android:paddingHorizontal="6dp"
            android:text="Sponsored"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@id/admob_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FF3B0764"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.gms.ads.nativead.MediaView
            android:id="@id/admob_media"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@id/admob_call_to_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#FF7C3AED"
            android:textColor="#FFFFFFFF" />
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
